// ZKSessionSync: QR Session Authentication Circuit
// SECURITY FIX: ECDSA signature verification is now mandatory.
// The commented-out verify_signature has been restored and is the
// core soundness property of this contract.
//
// Proof: The mobile device proves it knows the private key corresponding
// to `mobile_pub_key` by producing a valid ECDSA signature over
// `session_challenge`. Only the ZK proof is transmitted — the private
// key never leaves the device.

contract ZKSessionSync {
    use dep::aztec::prelude::{
        AztecAddress, PrivateContext, Map, PublicMutable
    };

    #[aztec(storage)]
    struct Storage {
        // Maps a Session Challenge (Field) -> authenticated (bool)
        // Desktop polls this to know when mobile has proven ownership.
        authenticated_sessions: Map<Field, PublicMutable<bool>>,
        // Replay attack prevention: tracks used challenge hashes
        used_challenges: Map<Field, PublicMutable<bool>>,
    }

    #[aztec(private)]
    #[aztec(initializer)]
    fn constructor() {}

    // authenticate_session
    //
    // Called by the mobile device to prove wallet ownership and authorize
    // a desktop QR session — without revealing the private key.
    //
    // Soundness guarantee:
    //   The circuit enforces that `signature` is a valid secp256k1 ECDSA
    //   signature of `session_challenge` under `mobile_pub_key`.
    //   Without a valid signature, the proof cannot be generated.
    //   Any proof that verifies on-chain is therefore a cryptographic
    //   certificate of key ownership.
    //
    // Parameters:
    //   session_challenge  - The unique nonce generated by the desktop QR.
    //                        Binds this proof to exactly one session.
    //   mobile_pub_key_x   - X coordinate of the mobile device's secp256k1 pubkey.
    //   mobile_pub_key_y   - Y coordinate of the mobile device's secp256k1 pubkey.
    //   signature          - 64-byte ECDSA signature: [r (32 bytes) || s (32 bytes)].
    //                        Signs the raw bytes of session_challenge.
    #[aztec(private)]
    fn authenticate_session(
        session_challenge: Field,
        mobile_pub_key_x: [u8; 32],
        mobile_pub_key_y: [u8; 32],
        signature: [u8; 64],
    ) {
        // --- CONSTRAINT 1: Replay Attack Prevention ---
        // Each session_challenge can only be consumed once.
        // The public mark_challenge_used call writes `true` to used_challenges.
        // If this challenge was already used, the public function will assert-fail.
        ZKSessionSync::at(context.this_address())
            .mark_challenge_used(session_challenge)
            .enqueue(&mut context);

        // --- CONSTRAINT 2: ECDSA Signature Verification (SOUNDNESS CORE) ---
        // Decompose the session_challenge Field into 32 bytes for the ECDSA verifier.
        // The verifier checks: ecdsa_verify(pub_key_x, pub_key_y, sig, msg_hash) == true
        // This is a native Noir constraint — it cannot be bypassed or faked.
        let challenge_bytes: [u8; 32] = session_challenge.to_be_bytes();

        let is_valid = std::ecdsa_secp256k1::verify_signature(
            mobile_pub_key_x,
            mobile_pub_key_y,
            signature,
            challenge_bytes,
        );

        // assert() is a ZK constraint — the proof is invalid if is_valid == false.
        // No valid proof can be generated without a correct signature.
        assert(is_valid, "ECDSA: Invalid signature for session challenge");

        // --- CONSTRAINT 3: Authorize Session (only if constraints 1+2 pass) ---
        ZKSessionSync::at(context.this_address())
            .mark_session_authenticated(session_challenge)
            .enqueue(&mut context);
    }

    #[aztec(public)]
    #[aztec(internal)]
    fn mark_challenge_used(session_challenge: Field) {
        // Replay attack prevention: enforce single-use
        assert(
            !storage.used_challenges.at(session_challenge).read(),
            "Challenge already consumed: replay attack detected"
        );
        storage.used_challenges.at(session_challenge).write(true);
    }

    #[aztec(public)]
    #[aztec(internal)]
    fn mark_session_authenticated(session_challenge: Field) {
        storage.authenticated_sessions.at(session_challenge).write(true);
    }

    #[aztec(public)]
    fn is_session_authenticated(session_challenge: Field) -> bool {
        storage.authenticated_sessions.at(session_challenge).read()
    }
}
